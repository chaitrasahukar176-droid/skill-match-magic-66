# ---------------------------------------------------------------------------
# Copy these into Vercel -> Project Settings -> Environment Variables
# (add them to Production, Preview and Development)
# ---------------------------------------------------------------------------

# Supabase (safe to expose - publishable/anon key)
SUPABASE_PROJECT_ID="trslvvicqwngqienwold"
SUPABASE_URL="https://trslvvicqwngqienwold.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="trslvvicqwngqienwold"
VITE_SUPABASE_URL="https://trslvvicqwngqienwold.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Demo login - required for the one-click "Explore the demo workspace" button
VITE_DEMO_EMAIL="demo@skillmatch.ai"
VITE_DEMO_PASSWORD="skillmatch-demo"
DEMO_EMAIL="demo@skillmatch.ai"
DEMO_PASSWORD="skillmatch-demo"

# Optional. Only needed if you want the app to auto-create/re-seed the demo
# account when it is missing. The demo account already exists in Supabase, so
# you can leave this out for a normal Vercel deploy. NEVER expose with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional. Only needed for AI resume parsing / matching features.
LOVABLE_API_KEY=""
